/* Ironhold — GNOME Shell theme (needs the "User Themes" extension).
 * Imports the stock dark stylesheet, then re-dresses the panel, dash, menus, notifications and dialogs.
 */
@import url("resource:///org/gnome/shell/theme/gnome-shell-dark.css");

/* ---------------------------------------------------------------- top panel */
#panel {
  background-color: {{bg_alt}};
  background-gradient-direction: vertical;
  background-gradient-start: {{surface_hi}};
  background-gradient-end: {{bg_alt}};
  border-bottom: 2px solid {{metal_lo}};
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.6);
  font-weight: bold;
}
#panel .panel-button { color: {{parchment}}; }
#panel .panel-button:hover,
#panel .panel-button:focus { background-color: {{metal,0.18}}; color: {{metal_hi}}; box-shadow: inset 0 0 0 1px {{metal_lo}}; }
#panel .panel-button:active,
#panel .panel-button:checked { background-color: {{accent}}; color: {{text_on_accent}}; box-shadow: inset 0 0 0 1px {{metal}}; }
#panel .panel-button.clock-display .clock { color: {{metal_hi}}; letter-spacing: 1px; }
#panel .workspace-dot { background-color: {{metal}}; }
#panel.unlock-screen, #panel.login-screen, #panel.lock-screen { background-color: transparent; border-bottom: none; box-shadow: none; }

/* ---------------------------------------------------------------- popup menus & quick settings */
.popup-menu-content, .quick-settings, .candidate-popup-content {
  background-color: {{surface}};
  border: 1px solid {{metal_lo}};
  box-shadow: inset 0 0 0 1px {{bg_alt}}, 0 6px 18px rgba(0, 0, 0, 0.7);
  color: {{text}};
}
.popup-menu-item:hover, .popup-menu-item:focus, .popup-menu-item.selected {
  background-color: {{accent}};
  color: {{text_on_accent}};
}
.popup-menu-item:checked { background-color: {{surface_hi}}; }
.popup-separator-menu-item .popup-separator-menu-item-separator { background-color: {{metal_lo}}; }

.quick-toggle, .quick-menu-toggle .quick-toggle {
  background-color: {{surface_hi}};
  box-shadow: inset 0 0 0 1px {{metal_lo}};
  color: {{text}};
}
.quick-toggle:hover { background-color: {{border_hi}}; }
.quick-toggle:checked, .quick-menu-toggle .quick-toggle:checked,
.quick-menu-toggle .quick-toggle-arrow:checked {
  background-color: {{accent}};
  box-shadow: inset 0 0 0 1px {{metal}};
  color: {{text_on_accent}};
}
.quick-toggle-menu { background-color: {{bg}}; border: 1px solid {{metal_lo}}; }
.quick-slider .slider, .slider {
  -barlevel-active-background-color: {{metal}};
  -barlevel-background-color: {{bg_alt}};
  -slider-handle-border-color: {{metal_lo}};
  color: {{metal_hi}};
}
.toggle-switch:checked { background-color: {{accent}}; }

/* ---------------------------------------------------------------- dash & overview */
#dash .dash-background, #dashtodockContainer #dash .dash-background {
  background-color: {{bg_alt,0.88}};
  border: 1px solid {{metal_lo}};
  box-shadow: inset 0 1px {{metal,0.25}};
}
.dash-item-container .app-well-app:hover .overview-icon,
.dash-item-container .show-apps:hover .overview-icon { background-color: {{metal,0.18}}; }
.app-well-app-running-dot, .app-grid-running-dot { background-color: {{metal_hi}}; }
.dash-separator { background-color: {{metal_lo}}; }

.search-entry {
  background-color: {{bg_alt}};
  border: 1px solid {{metal_lo}};
  color: {{text}};
  caret-color: {{metal_hi}};
  selection-background-color: {{metal}};
}
.search-entry:focus { border-color: {{metal}}; box-shadow: inset 0 0 0 1px {{metal}}; }

.app-folder-dialog { background-color: {{surface}}; border: 1px solid {{metal_lo}}; }
.workspace-thumbnail-indicator { border-color: {{metal}}; }
.window-caption { background-color: {{bg_alt}}; color: {{metal_hi}}; border: 1px solid {{metal_lo}}; }

/* ---------------------------------------------------------------- calendar & notifications */
.datemenu-today-button .date-label { color: {{metal_hi}}; }
.calendar-today { background-color: {{accent}}; color: {{text_on_accent}}; font-weight: bold; }
.calendar-day-with-events { color: {{metal_hi}}; }
.message, .notification-banner, .message-list .message {
  background-color: {{surface_hi}};
  border: 1px solid {{metal_lo}};
  color: {{text}};
}
.message:hover { background-color: {{border_hi}}; }
.message .message-title { color: {{metal_hi}}; }

/* ---------------------------------------------------------------- dialogs & OSD */
.modal-dialog {
  background-color: {{surface}};
  border: 2px solid {{metal_lo}};
  box-shadow: inset 0 0 0 1px {{bg_alt}};
  color: {{text}};
}
.modal-dialog .modal-dialog-linked-button { background-color: {{surface_hi}}; color: {{text}}; }
.modal-dialog .modal-dialog-linked-button:hover { background-color: {{accent}}; color: {{text_on_accent}}; }
.end-session-dialog .modal-dialog-linked-button:last-child { background-color: {{danger}}; }

.osd-window, .switcher-popup .switcher-list, .workspace-switcher-container {
  background-color: {{bg_alt,0.94}};
  border: 1px solid {{metal_lo}};
  color: {{text}};
}
.switcher-list .item-box:selected, .switcher-list .item-box:hover { background-color: {{accent}}; }
.osd-window .level-bar { background-color: {{metal}}; }

.button, .notification-button, .hotplug-notification-item {
  background-color: {{surface_hi}};
  border: 1px solid {{metal_lo}};
  color: {{text}};
}
.button:hover, .notification-button:hover { background-color: {{accent}}; border-color: {{metal}}; color: {{text_on_accent}}; }
.button.default, .modal-dialog-button.default { background-color: {{accent}}; border-color: {{metal}}; }

/* ---------------------------------------------------------------- lock / login */
.unlock-dialog-clock-time { color: {{metal_hi}}; font-weight: 800; }
.unlock-dialog-clock-date { color: {{parchment}}; }
.login-dialog-prompt-entry, .unlock-dialog .login-dialog-prompt-entry { border: 1px solid {{metal}}; background-color: {{bg_alt,0.8}}; }

/* ---------------------------------------------------------------- ornate layer (assets/ generated by build.py) */
#panel {
  background-image: url("assets/panel.png");
  background-size: cover;
}
#panel .panel-button, #panel .panel-button .clock {
  font-family: "Cinzel", serif;
  font-weight: 700;
}
.unlock-dialog-clock-time, .unlock-dialog-clock-date, .modal-dialog .headline, .message .message-title {
  font-family: "Cinzel", serif;
}
.popup-menu-content, .modal-dialog, .app-folder-dialog {
  border: 12px solid transparent;
  border-image: url("assets/frame-48.png") 12;
  border-radius: 0;
}
